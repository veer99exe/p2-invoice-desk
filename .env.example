# Copy to .env (git-ignored). Never commit real values.
P4_API_URL=https://<P4 srv route>/odata/v4/integration
P4_TOKEN_URL=<"url" from P4's service key>
P4_CLIENT_ID=<"clientid" from P4's service key>
P4_CLIENT_SECRET=<"clientsecret" from P4's service key>
GROQ_API_KEY=<your own Groq key>
# S/4 sandbox key: put it in .cdsrc-private.json (see README) or here:
# S4_API_KEY=<your sandbox key>
